NODE_ENV=development
PORT=4000
DATABASE_URL=mysql://crevantia_app:change_me@127.0.0.1:3306/crevantia
FRONTEND_URL=http://localhost:3000
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-another-32-random-characters
ENCRYPTION_KEY=replace-with-a-third-32-byte-random-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=7
MAIL_PROVIDER=smtp
MAIL_FROM_NAME=Crevantia
MAIL_FROM_ADDRESS=no-reply@example.com
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
STORAGE_DRIVER=local
STORAGE_BUCKET=crevantia-private
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-me
