[Unit]
Description=Crevantia Web (Next.js)
After=network.target crevantia-backend.service

[Service]
Type=simple
User=crevantia
Group=crevantia
WorkingDirectory=/var/www/crevantia
Environment=NODE_ENV=production
ExecStart=/usr/bin/npm run start:frontend
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
